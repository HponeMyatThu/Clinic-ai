# =============================================================================
# GCMS Clinical AI Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=gcms-ai-backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gcms_ai
POSTGRES_USER=gcms
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- Ollama (Local AI) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# AI behaviour
AI_PROVIDER=ollama
AI_TEMPERATURE=0
AI_MAX_TOKENS=4096

# --- SNOMED CT ---
SNOMED_RELEASE_VERSION=dev-seed-2024
SNOMED_EDITION=International

# --- SDD (Singapore Drug Dictionary) ---
SDD_CATALOGUE_VERSION=dev-seed-2024

# --- Security / Auth ---
# OIDC / JWT — configure when integrating with your identity provider
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=RS256
JWT_ISSUER=https://your-idp.example.com
JWT_AUDIENCE=gcms-ai-backend
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CMS Integration ---
CMS_BASE_URL=http://localhost:9000/api
CMS_TIMEOUT=30
CMS_MAX_RETRIES=2

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Privacy ---
# Set to true in production to enable PII stripping before sending context to Ollama
ENABLE_PII_FILTER=true

